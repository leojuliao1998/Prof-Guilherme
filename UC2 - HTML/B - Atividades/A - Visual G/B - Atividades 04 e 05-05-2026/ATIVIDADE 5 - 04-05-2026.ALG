Algoritmo "Atividade 5 - 04-05-2026"

Var
valor_reais: real
valor_dolar: real
valor_convertido: real

Inicio

escreval ("Com o dólar hoje cotado em R$ 5,00 e tenho o seguinte valor em reais:")
leia (valor_reais)

valor_dolar <- 5

valor_convertido <- valor_reais / valor_dolar

escreval ("Obterei, $",valor_convertido)


Fimalgoritmo